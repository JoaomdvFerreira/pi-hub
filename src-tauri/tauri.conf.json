{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi-Hub",
  "version": "0.1.0",
  "identifier": "com.pihub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi-Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "João Ferreira",
    "copyright": "Copyright © 2026 João Ferreira",
    "shortDescription": "Monitor and access your self-hosted infrastructure",
    "longDescription": "Pi-Hub is a Windows system-tray control center for monitoring and quickly accessing personal self-hosted infrastructure (Raspberry Pi devices, Docker containers, and web services) over SSH and Tailscale.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
